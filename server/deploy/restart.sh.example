#!/bin/bash
# 在服务器上与 app.py 同目录执行：重启服务
# pkill 模式用 [a]pp.py 防止匹配到本脚本或 ssh 会话自身的命令行
set -e
cd "$(dirname "$0")"

PUBLIC_HOST="${PUBLIC_HOST:-127.0.0.1}"   # 改成你的公网 IP / 域名
PORT="${PORT:-12900}"

pkill -f "[a]pp.py --port $PORT" || true
sleep 1
setsid nohup python3 app.py --port "$PORT" --public-host "$PUBLIC_HOST" \
  > server.log 2>&1 < /dev/null &
sleep 1
pgrep -af "[a]pp.py --port $PORT" || { echo "启动失败，见 server.log"; exit 1; }